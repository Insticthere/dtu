{
  "name": "legal-metrology-verification-system",
  "version": "1.0.0",
  "description": "National Legal Metrology Verification System MVP (Backend API + React Frontend)",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run preview",
    "seed": "cd backend && npm run seed",
    "test": "cd backend && node src/testIntegration.js",
    "build": "cd frontend && npm run build",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "keywords": [
    "legal-metrology",
    "verification",
    "stamping",
    "india",
    "weights-and-measures",
    "qr-code",
    "rbac"
  ],
  "author": "e-Metrology Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
