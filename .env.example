# =============================================================================
# MentorConnect — Environment Variables
# Copy this file to .env at the project root and fill in every value.
# This is the ONE configuration file for both the backend and frontend.
# =============================================================================

# ---- Server ----
# Port the Express backend (and, in production, the built frontend) will run on.
PORT=5000

# ---- Database ----
# Full MongoDB Atlas connection string. Replace <user>, <password>, and <cluster>
# with the values from your Atlas cluster's "Connect > Drivers" dialog.
# The database name (mentorconnect) is embedded in the URI — Atlas will create it
# automatically on first write if it doesn't exist yet.
# IMPORTANT: Never use mongodb://localhost here — this app requires a remote Atlas cluster.
MONGO_URI=mongodb+srv://<user>:<password>@<your-cluster>.mongodb.net/mentorconnect?retryWrites=true&w=majority

# ---- JWT ----
# Secret used to sign and verify all JWT tokens.
# Use a long, random string (e.g. `openssl rand -hex 64`). Never commit the real value.
JWT_SECRET=<strong-random-string-at-least-32-chars>

# Expiry for issued tokens. "7d" = 7 days. Accepts any value accepted by the
# jsonwebtoken library (e.g. "1h", "30m", "7d").
JWT_EXPIRES_IN=7d

# ---- Admin Seed ----
# The admin account is NOT self-registrable (deliberate security choice — see README).
# Instead, run `npm run seed` once to create exactly one admin from these values.
# If you re-run seed, it checks for the email first and skips if already present.
ADMIN_SEED_NAME=Admin
ADMIN_SEED_EMAIL=admin@mentorconnect.local
ADMIN_SEED_PASSWORD=<set-a-strong-admin-password>
